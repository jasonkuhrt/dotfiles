{
  "cleanupPeriodDays": 999999,
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "MultiEdit",
      "Write",
      "Read(~/**)",
      "Read(//tmp/**)",
      "WebFetch",
      "WebSearch",
      "mcp__claude-in-chrome",
      "mcp__effect-docs",
      "Skill(dotfiles-doctor)",
      "mcp__Claude_Preview",
      "mcp__mcp-registry",
      "mcp__Claude_in_Chrome"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/jasonkuhrt"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "code-review": "off",
    "simplify": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "superpowers-dev@superpowers-marketplace": true,
    "tsgo-lsp@jasonkuhrt": false,
    "show-me@skills": true,
    "linear@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "jasonkuhrt": {
      "source": {
        "source": "directory",
        "path": "/Users/jasonkuhrt/projects/jasonkuhrt/claude-marketplace"
      },
      "autoUpdate": true
    },
    "skills": {
      "source": {
        "source": "github",
        "repo": "humanlayer/skills"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
