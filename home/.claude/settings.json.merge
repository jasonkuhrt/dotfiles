      "mcp__06010e7d-3018-4a4f-934e-bf899f68965e__search_documentation",
      "mcp__06010e7d-3018-4a4f-934e-bf899f68965e__whoami",
      "mcp__06010e7d-3018-4a4f-934e-bf899f68965e__extract_images",
