{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "asi"
  },
  "json": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "trailingCommas": "never",
    "commentLine.forceSpaceAfterSlashes": true,
    "ignoreNodeCommentText": "dprint-ignore"
  },
  "markdown": {
    "lineWidth": 100,
    "textWrap": "maintain",
    "strongKind": "underscores",
    "list.unorderedMarker": "asterisks"
  },
  "toml": {},
  "yaml": {},
  "graphql": {},
  "malva": {},
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/pnpm-lock.yaml",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/__snapshots__",
    "**/*.quality.md"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-graphql@0.2.3"
  ]
}
