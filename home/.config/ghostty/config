#
# Ghostty Config (read by cmux — primary terminal)
#
# Reference:
# https://ghostty.org/docs/config/reference
#

theme = tokyonight

#
# Typography
#

font-family    = "Monaspace Neon"
font-size      = 14

#
# Window
#

macos-titlebar-proxy-icon = hidden

#
# Cursor
#

adjust-cursor-thickness = 3
cursor-style-blink      = false
cursor-opacity          = 0.3


#
# Security
#

clipboard-paste-protection = false
confirm-close-surface      = true

#
# Notifications & Bell
#
# OSC 777 notifications → macOS Notification Center
# Bell features: dock bounce + badge for attention when unfocused
#

bell-features = attention

#
# Keyboard
#
# Ghostty turns Option into Alt by default only on U.S. layouts. This machine is on
# Canadian, where Option+hjkl types ˙∆˚¬ and Neovim never sees <A-hjkl>. Left Option
# becomes Alt; right Option keeps macOS character input.
#

macos-option-as-alt = left

#
# Keybindings
#

keybind = ctrl+apostrophe=clear_screen
keybind = shift+enter=text:\n
