#!/usr/bin/env bash
set -euo pipefail

# @describe Switch to the next or previous surface (tab) in the current cmux pane.

# cmux has no CLI verb for relative surface focus, so this sends cmux's own
# nextSurface/prevSurface shortcuts (cmd+shift+] and cmd+shift+[) via osascript.

_keystroke() {
    osascript -e "tell application \"System Events\" to keystroke \"$1\" using {command down, shift down}" &
}

# @cmd Switch to the next surface (tab) in the current pane
# @alias ns
next_surface() {
    _keystroke "]"
}

# @cmd Switch to the previous surface (tab) in the current pane
# @alias ps
prev_surface() {
    _keystroke "["
}

eval "$(argc --argc-eval "$0" "$@")"
