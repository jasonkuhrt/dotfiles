#!/usr/bin/env bash
set -euo pipefail

# @describe Conductor's CLI (cloud workspaces, sessions, routines), which ships
# inside the app bundle rather than on PATH. Installed by the `conductor` cask in
# scripts/data/Brewfile.

real="/Applications/Conductor.app/Contents/Resources/bin/conductor"
if [[ ! -x "$real" ]]; then
  echo "conductor: $real not found; install the app with: brew install --cask conductor" >&2
  exit 127
fi
exec "$real" "$@"
