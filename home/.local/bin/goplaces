#!/usr/bin/env bash

set -euo pipefail

readonly goplaces_bin="/opt/homebrew/bin/goplaces"
readonly api_key_ref="op://MeOS/Google Maps API key/credential"

if [[ ! -x "$goplaces_bin" ]]; then
  echo "goplaces: install with 'brew install openclaw/tap/goplaces'" >&2
  exit 127
fi

if [[ -z "${GOOGLE_PLACES_API_KEY:-}" ]]; then
  if ! GOOGLE_PLACES_API_KEY="$(meos-op read "$api_key_ref" 2>/dev/null)"; then
    echo "goplaces: no API key at $api_key_ref" >&2
    exit 78
  fi
  export GOOGLE_PLACES_API_KEY
fi

exec "$goplaces_bin" "$@"
