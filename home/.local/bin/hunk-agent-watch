#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: hunk-agent-watch [options]

Watch a live Hunk session for saved user notes and send Codex a repo-scoped
prompt when the note set changes.

Options:
  --repo <path>           Repo/worktree to watch. Defaults to $PWD.
  --interval <seconds>    Poll interval. Defaults to 1.
  --transport <kind>      auto, desktop, exec, or print. Defaults to auto.
  --background            Start one watcher for the repo in the background.
  --once                  Poll once and exit after priming or triggering.
  --emit-existing         Trigger on already-existing notes at first poll.
  --status                Show watcher status for the repo.
  --stop                  Stop the background watcher for the repo.
  -h, --help              Show this help.

Environment:
  HUNK_AGENT_TRANSPORT        auto, desktop, exec, or print
  HUNK_AGENT_WATCH_INTERVAL   poll interval in seconds
  HUNK_AGENT_STATE_DIR        state directory
USAGE
}

die() {
    printf 'hunk-agent-watch: %s\n' "$*" >&2
    exit 1
}

log() {
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2
}

repo="${PWD}"
interval="${HUNK_AGENT_WATCH_INTERVAL:-1}"
transport="${HUNK_AGENT_TRANSPORT:-auto}"
background=0
once=0
emit_existing=0
status=0
stop=0

while (($#)); do
    case "$1" in
        --repo)
            (($# >= 2)) || die "--repo needs a value"
            repo="$2"
            shift 2
            ;;
        --interval)
            (($# >= 2)) || die "--interval needs a value"
            interval="$2"
            shift 2
            ;;
        --transport)
            (($# >= 2)) || die "--transport needs a value"
            transport="$2"
            shift 2
            ;;
        --background)
            background=1
            shift
            ;;
        --once)
            once=1
            shift
            ;;
        --emit-existing)
            emit_existing=1
            shift
            ;;
        --status)
            status=1
            shift
            ;;
        --stop)
            stop=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

case "$transport" in
    auto|desktop|exec|print)
        ;;
    *)
        die "--transport must be auto, desktop, exec, or print"
        ;;
esac

[[ "$interval" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--interval must be numeric"

command -v hunk >/dev/null || die "hunk not found"
command -v jq >/dev/null || die "jq not found"

if git_root="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)"; then
    repo_root="$git_root"
else
    repo_root="$(cd "$repo" && pwd -P)"
fi

state_root="${HUNK_AGENT_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/hunk-agent-watch}"
repo_key="$(printf '%s' "$repo_root" | shasum -a 256 | awk '{print $1}')"
state_dir="$state_root/$repo_key"
pid_file="$state_dir/watch.pid"
hash_file="$state_dir/notes.sha256"
log_file="$state_dir/watch.log"
repo_file="$state_dir/repo"
script_path="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"

mkdir -p "$state_dir"
printf '%s\n' "$repo_root" >"$repo_file"

pid_alive() {
    local pid="${1:-}"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

current_pid() {
    [[ -f "$pid_file" ]] || return 1
    cat "$pid_file"
}

show_status() {
    local pid=""
    if pid="$(current_pid 2>/dev/null)" && pid_alive "$pid"; then
        printf 'running pid=%s repo=%s log=%s\n' "$pid" "$repo_root" "$log_file"
    else
        printf 'stopped repo=%s log=%s\n' "$repo_root" "$log_file"
    fi
}

if ((status)); then
    show_status
    exit 0
fi

if ((stop)); then
    if pid="$(current_pid 2>/dev/null)" && pid_alive "$pid"; then
        kill "$pid"
        printf 'stopped pid=%s repo=%s\n' "$pid" "$repo_root"
    else
        printf 'not running repo=%s\n' "$repo_root"
    fi
    rm -f "$pid_file"
    exit 0
fi

if ((background)); then
    if pid="$(current_pid 2>/dev/null)" && pid_alive "$pid"; then
        printf 'hunk-agent-watch already running pid=%s repo=%s\n' "$pid" "$repo_root"
        exit 0
    fi

    args=(
        --repo "$repo_root"
        --interval "$interval"
        --transport "$transport"
    )
    if ((emit_existing)); then
        args+=(--emit-existing)
    fi

    nohup "$script_path" "${args[@]}" >>"$log_file" 2>&1 &
    child_pid=$!
    printf '%s\n' "$child_pid" >"$pid_file"
    printf 'hunk-agent-watch started pid=%s repo=%s log=%s\n' "$child_pid" "$repo_root" "$log_file"
    exit 0
fi

if pid="$(current_pid 2>/dev/null)" && pid_alive "$pid" && [[ "$pid" != "$$" ]]; then
    printf 'hunk-agent-watch already running pid=%s repo=%s\n' "$pid" "$repo_root"
    exit 0
fi

printf '%s\n' "$$" >"$pid_file"
cleanup() {
    if [[ -f "$pid_file" ]] && [[ "$(cat "$pid_file")" == "$$" ]]; then
        rm -f "$pid_file"
    fi
}
trap cleanup EXIT

session_id=""
first_snapshot=1

select_session_id() {
    local raw count selected
    raw="$(hunk session list --json 2>/dev/null)" || return 1
    count="$(printf '%s\n' "$raw" | jq --arg repo "$repo_root" '[.sessions[]? | select(.repoRoot == $repo)] | length')"
    if ((count == 0)); then
        return 1
    fi

    selected="$(printf '%s\n' "$raw" | jq -r --arg repo "$repo_root" '
        [.sessions[]? | select(.repoRoot == $repo)]
        | sort_by(.launchedAt // "")
        | last
        | .sessionId // empty
    ')"
    [[ -n "$selected" ]] || return 1

    if [[ "$selected" != "$session_id" ]]; then
        if ((count > 1)); then
            log "multiple Hunk sessions match repo; using newest session=$selected"
        else
            log "bound Hunk session=$selected"
        fi
        session_id="$selected"
        first_snapshot=1
    fi
}

snapshot_notes() {
    local raw
    select_session_id || return 1
    raw="$(hunk session comment list "$session_id" --type user --json 2>/dev/null)" || return 1
    printf '%s\n' "$raw" | jq -cS '{
        comments: ((.comments // []) | sort_by(
            .noteId // .commentId // "",
            .filePath // "",
            .hunkIndex // -1,
            .body // .summary // ""
        ))
    }'
}

has_notes() {
    jq -e '(.comments // []) | length > 0' >/dev/null
}

sha256() {
    shasum -a 256 | awk '{print $1}'
}

build_prompt() {
    local notes_json="$1"
    local context_command
    local comments_command
    local review_command

    if [[ -n "$session_id" ]]; then
        context_command="hunk session context \"$session_id\" --json"
        comments_command="hunk session comment list \"$session_id\" --type user --json"
        review_command="hunk session review \"$session_id\" --json --include-notes"
    else
        context_command="hunk session context --repo \"$repo_root\" --json"
        comments_command="hunk session comment list --repo \"$repo_root\" --type user --json"
        review_command="hunk session review --repo \"$repo_root\" --json --include-notes"
    fi

    cat <<PROMPT
A Hunk user review note was saved for this repo:
$repo_root

Target Hunk session:
${session_id:-repo selector $repo_root}

Use the hunk-review skill and live Hunk session commands against that target. Start by reading the active context and saved user notes:

  $context_command
  $comments_command
  $review_command

Then address the newest unresolved user note. If it asks for a code change, implement it in the repo, preserve unrelated changes, and verify narrowly. If it asks a question, answer by adding an agent note/comment in Hunk on the relevant file or hunk.

Current user-note snapshot:
$notes_json
PROMPT
}

send_desktop() {
    local prompt="$1"
    command -v codex >/dev/null || die "codex not found"
    (
        cd "$repo_root"
        codex remote-control start --json >/dev/null
        codex debug app-server send-message-v2 "$prompt" >/dev/null
    )
}

send_exec() {
    local prompt="$1"
    command -v codex >/dev/null || die "codex not found"
    codex exec -C "$repo_root" --dangerously-bypass-approvals-and-sandbox "$prompt"
}

send_to_codex() {
    local notes_json="$1"
    local prompt
    prompt="$(build_prompt "$notes_json")"

    case "$transport" in
        auto)
            if send_desktop "$prompt"; then
                return 0
            fi
            log "desktop Codex transport unavailable; falling back to codex exec"
            send_exec "$prompt"
            ;;
        desktop)
            send_desktop "$prompt"
            ;;
        exec)
            send_exec "$prompt"
            ;;
        print)
            printf '%s\n' "$prompt"
            ;;
    esac
}

log "watching repo=$repo_root transport=$transport interval=${interval}s"

while true; do
    if notes_json="$(snapshot_notes)"; then
        hash="$(printf '%s' "$notes_json" | sha256)"
        previous_hash=""
        if [[ -f "$hash_file" ]]; then
            previous_hash="$(cat "$hash_file")"
        fi

        if ((first_snapshot)); then
            printf '%s\n' "$hash" >"$hash_file"
            first_snapshot=0

            if ((emit_existing)) && printf '%s\n' "$notes_json" | has_notes; then
                log "detected Hunk user-note change; sending Codex prompt"
                if send_to_codex "$notes_json"; then
                    log "Codex prompt sent"
                else
                    log "Codex prompt failed"
                fi
            else
                log "primed Hunk user-note snapshot"
            fi
        elif [[ "$hash" != "$previous_hash" ]]; then
            printf '%s\n' "$hash" >"$hash_file"

            if printf '%s\n' "$notes_json" | has_notes; then
                log "detected Hunk user-note change; sending Codex prompt"
                if send_to_codex "$notes_json"; then
                    log "Codex prompt sent"
                else
                    log "Codex prompt failed"
                fi
            else
                log "Hunk user notes cleared"
            fi
        fi
    else
        log "waiting for an active Hunk session"
    fi

    ((once)) && exit 0
    sleep "$interval"
done
