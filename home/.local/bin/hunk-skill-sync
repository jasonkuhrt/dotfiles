#!/usr/bin/env bash
set -euo pipefail

skill_path="$(hunk skill path)"
if [ ! -f "$skill_path" ]; then
  printf 'hunk skill not found: %s\n' "$skill_path" >&2
  exit 1
fi

# Resolve through the ~/.local/bin symlink: that directory is real and is not
# in the dotfiles repo, so dirname alone lands outside Git.
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(dirname "$script_path")"
repo_root="$(git -C "$script_dir" rev-parse --show-toplevel)"

claude_library_dir="$repo_root/home/.claude/skills-library/hunk-review"
claude_link="$repo_root/home/.claude/skills/hunk-review"

mkdir -p "$claude_library_dir"
cp "$skill_path" "$claude_library_dir/SKILL.md"
ln -sfn "$HOME/.claude/skills-library/hunk-review" "$claude_link"

printf 'synced Claude skill: %s\n' "$claude_library_dir/SKILL.md"
printf 'synced Claude skill link: %s\n' "$claude_link"
