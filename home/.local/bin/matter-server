#!/bin/bash
set -euo pipefail

# scripts/setup/after/24-matter-server.sh installs the pinned package.
entry="$HOME/.local/share/matter-server/node_modules/matter-server/dist/esm/bin.js"

if [ ! -f "$entry" ]; then
    printf 'matter-server is not installed. Run: just matter-server-setup\n' >&2
    exit 1
fi

exec node "$entry" "$@"
