#!/usr/bin/env bash
# op, signed in as the MeOS agent token, so it never asks Jason for Touch ID.
# Every agent and MeOS tool uses this command for approved 1Password vaults:
# MeOS by default, plus each child's approved shared vault.
#   meos-op read "op://MeOS/<item>/<field>"
#   meos-op item get <item> --vault MeOS --otp
# The token lives in the Keychain item op-service-account:meos (see the
# meos-credentials skill in ~/me).

set -euo pipefail

if ! token="$(security find-generic-password -s op-service-account:meos -w 2>/dev/null)"; then
  echo "meos-op: the Keychain has no op-service-account:meos item; see the meos-credentials skill" >&2
  exit 78
fi

unset OP_ACCOUNT
export OP_SERVICE_ACCOUNT_TOKEN="$token"
# By full path, where 20-1password-cli.sh installs it: a caller such as
# browse's relay may run this with a PATH that lacks ~/.local/bin.
exec "$HOME/.local/bin/op" "$@"
