#!/usr/bin/env bash
# msgvault-documents-build: extract the text of archived document attachments
# with the local Docling Serve, a few at a time.
#
# msgvault never schedules extraction, so the LaunchAgent
# com.jasonkuhrt.msgvault.documents runs this at 01:00, 02:00, 03:00 and
# 04:00. A run with no document waiting reads msgvault's status and exits
# without starting Docling. Otherwise it runs again under docling-serve-lease,
# which starts Docling Serve on loopback unless it already answers, extracts
# at most MSGVAULT_DOCUMENTS_LIMIT documents (100 by default), retries any
# that are due, and lets the lease go. The server stops after its last lease,
# so its ~1.2 GB stays free between runs, and MeOS's document text pass can
# share it without either stopping it under the other.
#
# Why at night: msgvault runs a CLI build while holding its daemon's
# operation gate for the whole run, and every scheduled sync waits behind it
# (kenn-io/msgvault#1996). Ten documents held it for 6m22s on 2026-11-07,
# long enough for a sign-in to miss an emailed code.
set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
BIN="$HOME/.local/bin/msgvault"
LIMIT="${MSGVAULT_DOCUMENTS_LIMIT:-100}"

log() { echo "$(date '+%Y-%m-%dT%H:%M:%S%z') msgvault-documents-build: $*"; }

status=$("$BIN" --no-log-file documents status --json)
missing=$(jq -r '.status.missing_owners' <<<"$status")
retrying=$(jq -r '.status.retry_owners' <<<"$status")
if [ "$missing" -eq 0 ] && [ "$retrying" -eq 0 ]; then
  exit 0
fi

if [ -z "${DOCLING_SERVE_LEASED:-}" ]; then
  DOCLING_SERVE_LEASED=1 exec "$HOME/.local/bin/docling-serve-lease" "$0" "$@"
fi

log "$missing missing, $retrying retrying; extracting at most $LIMIT"
if [ "$missing" -gt 0 ]; then
  "$BIN" documents build --limit "$LIMIT" --yes | tail -n 1
fi
if [ "$retrying" -gt 0 ]; then
  "$BIN" documents resume --limit "$LIMIT" --yes | tail -n 1
fi
