prefix=~/.npm-global
init-author-name=Jason Kuhrt
init-author-email=jasonkuhrt@me.com
init-author-url=https://kuhrt.me

# npm 12 blocks install scripts unless the package is allowlisted; these globals need theirs to fetch their binaries.
allow-scripts=bun,dprint,nx,@steipete/peekaboo,protobufjs,puppeteer
