[
  {
    "key": "cmd+h",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "cmd+l",
    "command": "workbenchCycler.nextInSequence",
    "args": {
      "sequence": [
        "all",
        "explorer",
        "full-terminal"
      ]
    }
  },
  {
    "key": "cmd+shift+l",
    "command": "workbenchCycler.nextInSequence",
    "args": {
      "sequence": [
        "full-terminal",
        "explorer",
        "all"
      ]
    }
  },
  {
    "key": "cmd+j",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "shift+cmd+h",
    "command": "workbench.files.action.focusFilesExplorer"
  },
  {
    "key": "ctrl+cmd+h",
    "command": "workbench.action.splitEditorLeft"
  },
  {
    "key": "ctrl+cmd+l",
    "command": "workbench.action.splitEditorRight"
  },
  {
    "key": "ctrl+cmd+k",
    "command": "workbench.action.splitEditorUp"
  },
  {
    "key": "ctrl+cmd+j",
    "command": "workbench.action.splitEditorDown"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "!suggestWidgetVisible && !inQuickOpen && !codeActionMenuVisible && !parameterHintsVisible && !referenceSearchVisible"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "!suggestWidgetVisible && !inQuickOpen && !codeActionMenuVisible && !parameterHintsVisible && !referenceSearchVisible"
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.terminal.clear",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "shift+j",
    "command": "list.focusLast",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "shift+k",
    "command": "list.focusFirst",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "shift+h",
    "command": "list.collapseAll",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "ctrl+j",
    "command": "selectNextCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+j",
    "command": "showNextParameterHint",
    "when": "parameterHintsVisible && parameterHintsMultipleSignatures"
  },
  {
    "key": "ctrl+k",
    "command": "showPrevParameterHint",
    "when": "parameterHintsVisible && parameterHintsMultipleSignatures"
  },
  {
    "key": "ctrl+j",
    "command": "goToNextReferenceFromEmbeddedEditor",
    "when": "referenceSearchVisible"
  },
  {
    "key": "ctrl+k",
    "command": "goToPreviousReferenceFromEmbeddedEditor",
    "when": "referenceSearchVisible"
  },
  {
    "key": "cmd+o",
    "command": "workbench.action.openRecent"
  },
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openFileFolder"
  },
  {
    "key": "alt+cmd+o",
    "command": "workbench.action.files.openFileFolder"
  },
  {
    "key": "shift+cmd+/",
    "command": "workbench.action.findInFiles"
  },
  {
    "key": "ctrl+'",
    "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+'",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeActiveEditor"
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.closeActiveEditor",
    "when": "groupEditorsCount != 1 || multipleEditorGroups"
  },
  {
    "key": "space k",
    "command": "workbench.action.quickOpen",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "space o",
    "command": "workbench.action.openRecent",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "space shift+o",
    "command": "projectManager.listProjects",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "space j",
    "command": "workbench.action.tasks.runTask",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "t e",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "t g",
    "command": "workbench.view.scm",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "t t",
    "command": "workbench.action.terminal.focus",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "t d",
    "command": "workbench.panel.markers.view.focus",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": ";",
    "command": "workbench.action.showCommands",
    "when": "(inWelcome || !editorIsOpen) && !inputFocus"
  },
  {
    "key": "ctrl+j",
    "command": "-editor.action.joinLines"
  },
  {
    "key": "shift+cmd+j",
    "command": "-workbench.action.search.toggleQueryDetails"
  },
  {
    "key": "cmd+alt+shift+m",
    "command": "jason.toggleProblemsVisibility",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+/",
    "command": "closeFindWidget",
    "when": "editorFocus && findWidgetVisible"
  },
  {
    "key": "d",
    "command": "explorerDelete.confirmTrash",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+d",
    "command": "explorerDelete.forceTrash",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "enter",
    "command": "-renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "enter",
    "command": "jason.explorerDigIn",
    "when": "filesExplorerFocus && !inputFocus && explorerResourceIsFolder"
  },
  {
    "key": "enter",
    "command": "list.select",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsFolder"
  },
  {
    "key": "shift+enter",
    "command": "jason.explorerDigOut",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "cmd+j",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && neovim.mode == 'visual'"
  },
  {
    "key": "cmd+k",
    "command": "editor.action.copyLinesUpAction",
    "when": "editorTextFocus && neovim.mode == 'visual'"
  },
  {
    "key": "cmd+k v",
    "command": "markdown.togglePreview",
    "when": "resourceLangId == 'markdown' && !notebookEditorFocused"
  },
  {
    "key": ";",
    "command": "workbench.action.showCommands",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus"
  }
]
