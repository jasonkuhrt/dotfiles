{
  "manifest_version": 3,
  "name": "Tab Presets",
  "version": "1.0.1",
  "description": "Save a window's tabs and pins. Open it again whenever you like.",
  "minimum_chrome_version": "135",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "storage"
  ],
  "key": "",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Presets",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
